{
  "name": "nodejs-examples",
  "version": "1.0.0",
  "description": "Node.js examples",
  "main": "index.js",
  "scripts": {
    "convertImageTest": "npx ts-node ./src/imageProcessing/convertImageTest",
    "bandifyExecutable": "npx ts-node ./src/imageProcessing/executable/bandifyExecutable",
    "blockifyExecutable": "npx ts-node ./src/imageProcessing/executable/blockifyExecutable",
    "splitifyExecutable": "npx ts-node ./src/imageProcessing/executable/splitifyExecutable",
    "build": "rimraf ./build && tsc",
    "start:dev": "npx nodemon",
    "start": "npm run build && node build/index.js",
    "lint": "eslint . --ext .ts",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "prettier-watch": "onchange 'src/**/*.ts' -- prettier --write {{changed}}",
    "test": "jest",
    "test:dev": "jest --watchAll"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run test && npm run prettier-format && npm run lint"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "canvas": "^3.2.3",
    "deep-copy-ts": "^0.5.4",
    "gifencoder": "^2.0.1",
    "is-valid-path": "^0.1.1",
    "jest-cucumber": "^4.5.0",
    "sharp": "^0.35.5",
    "stream": "^0.0.3"
  },
  "devDependencies": {
    "@types/is-valid-path": "^0.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "onchange": "^7.1.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
